# Copie este archivo como .env y escriba su clave de la API de Gemini (Google AI Studio).
# La clave solo la usa el backend, nunca se envía al navegador. No suba el .env a GitHub.
GEMINI_API_KEY=
# Modelo. Puede cambiarse sin tocar el código.
GEMINI_MODEL=gemini-3.5-flash-lite
# Máximo de tokens por respuesta y mensajes previos que se reenvían en el chat
GEMINI_MAX_TOKENS_SALIDA=1024
HISTORIAL_CHAT_MAX=10